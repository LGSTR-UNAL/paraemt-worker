KAFKA_BOOTSTRAP_SERVERS=kafka-kafka-bootstrap.hydraflowsim.svc.cluster.local:9092
CONSUMER_GROUP_ID=paraemt-workers
REQUEST_TOPIC=hydraflowsim.streaming.paraemt-simulations
RESULTS_TOPIC=hydraflowsim.streaming.simulation-results
SIMULATION_STATUS_TOPIC=hydraflowsim.streaming.simulation-status
MAX_POLL_INTERVAL_MS=3600000
PRODUCER_FLUSH_TIMEOUT=60
S3_ENDPOINT_URL=http://rustfs.hydraflowsim.svc.cluster.local:9000
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_RESOURCES_BUCKET=hydraflowsim-resources
S3_RESULTS_BUCKET=hydraflowsim-results
PARAEMT_TIMEOUT_S=3600
LOG_LEVEL=INFO
